# ==============================================================================
# Git Ignore Configuration (steering_ood)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Python, Virtual Environments & Build Artifacts
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
.venv/
.venv*/
venv/
env/
ENV/
ENV*/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# ------------------------------------------------------------------------------
# 2. Experiment Results, Heavy Artifacts & Large Dumps (Ignored by default)
# ------------------------------------------------------------------------------
# Run directories, outputs & logs
runs/**
!runs/**/
results/**
!results/**/
outputs/**
!outputs/**/
logs/**
!logs/**/

*.log
*.err
applogs*.txt
wandb/
lightning_logs/

# Data directories & caches
data/
cache/
caches/
.cache/
*.cache

# Model weights & checkpoints
*.pt
*.pth
*.ckpt
*.bin
*.safetensors
*.onnx
*.h5
*.hdf5

# Large binary serialization & array dumps
*.npz
*.npy
*.pkl
*.pickle
*.parquet
*.feather
*.arrow

# Large archives & bundles
*.tar
*.tar.gz
*.tgz
*.zip
*.gz
*.7z

# ------------------------------------------------------------------------------
# 3. Test Fixtures Exception (Small deterministic test fixture files)
# ------------------------------------------------------------------------------
!examples/**/*.npz
!examples/**/*.json

# ------------------------------------------------------------------------------
# 4. OS & Editor Metadata
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDEs & Editors
.idea/
.vscode/
*.swp
*.swo
*~

# ------------------------------------------------------------------------------
# 5. LaTeX Build Artifacts
# ------------------------------------------------------------------------------
*.aux
*.out
*.toc
*.bbl
*.blg
*.synctex.gz
*.fls
*.fdb_latexmk
paper/steering_ood.pdf

# ------------------------------------------------------------------------------
# 6. Markdown Files Whitelist (Always load/track all .md and .MD files everywhere)
# ------------------------------------------------------------------------------
!*.md
!*.MD
!**/*.md
!**/*.MD

# ------------------------------------------------------------------------------
# 7. Learned-direction run outputs (tracked with Git LFS, see .gitattributes)
# ------------------------------------------------------------------------------
!runs/learned_directions/**
